.venv/
__pycache__/
.pytest_cache/
*.py[cod]
.tmp_docx_review/
/.tmp_doc_build/
/.tmp_ppt_build/
/*.inspect.ndjson

# 明确分类 + 单层测试白名单；嵌套生成源码仍忽略。
/测试/*
!/测试/*测试.py
!/测试/conftest.py
!/测试/SeeThrough回归测试/
/测试/SeeThrough回归测试/*
!/测试/SeeThrough回归测试/*测试.py
!/测试/界面端到端测试/
/测试/界面端到端测试/*
!/测试/界面端到端测试/*测试.py
!/测试/benchmark工具/
/测试/benchmark工具/*
!/测试/benchmark工具/benchmark_artifacts.py
!/测试/benchmark工具/public_molecule_benchmark.py
!/测试/benchmark工具/public_molecule_evaluation.py
!/测试/benchmark工具/public_molecule_report.py
!/测试/benchmark工具/prepare_seethrough_references.py
!/测试/fixtures/
/测试/fixtures/*
!/测试/fixtures/seethrough/
/测试/fixtures/seethrough/*
!/测试/fixtures/seethrough/README.md
!/测试/fixtures/seethrough/补充数据2结构输入.csv
!/测试/fixtures/seethrough/补充数据2身份输入.csv
审计结果/
运行记录/
模型保存/
骨架检查/
.cache/

# 本地生成的候选、缓存、历史与用户数据：不得公开。
数据/中间结果/
数据/筛选结果/
数据/导出结果/
数据/软件数据库/*
!数据/软件数据库/.gitkeep
# SeeThrough 公开复现所需的人工核对标签与结构映射，不是本地运行缓存。
!数据/软件数据库/补充数据2论文最终10标签表.csv
!数据/软件数据库/补充数据3结构映射表.csv
数据/用户导入数据/*
!数据/用户导入数据/.gitkeep
数据/模型结果/*
!数据/模型结果/.gitkeep
数据/实验数据/*
!数据/实验数据/.gitkeep
数据/运行记录/*
!数据/运行记录/.gitkeep

# 凭据与本机配置：不得提交。
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.duckdb
*.duckdb.wal
*.parquet
*.log

# 源码快照和构建副产物不是源码；卫生测试同时拒绝它们出现在项目内。
/.tmp_*source*
/.target_profile*tmp*/
*.zip
*.sdz
